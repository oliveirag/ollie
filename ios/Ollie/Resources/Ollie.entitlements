<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple (Phase 4). Needs a paid Apple Developer team and an
	     App ID with the capability enabled before it works on a device; the
	     simulator build carries it so the button renders and the Debug test
	     identity path can stand in until the membership lands. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Push Notifications. Xcode swaps "development" for "production" when
	     the build is archived for distribution; a Debug device build gets
	     sandbox tokens, which the backend must send to the sandbox host. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- The backend sends signals as interruption-level time-sensitive, so they
	     break through Focus. Without this entitlement iOS downgrades them to
	     active and a 15-minute window can pass unseen. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>

# Xcode
xcuserdata/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager (ios/SignalAPI is a local package)
.build/

# Node / backend
node_modules/
dist/
coverage/
*.tsbuildinfo

# Secrets — .env.example documents the shape, real values never land in git
.env
.env.*
!.env.example

# Local tooling
.DS_Store
*.log
backend/scripts/out/
# introspect-mcp output (account numbers, positions) from `--out ./out`
backend/out/

# iOS: the project file is generated from ios/project.yml by XcodeGen and is a
# build product, not source. Checking it in would reintroduce exactly the
# pbxproj merge conflicts the declarative manifest exists to avoid.
ios/*.xcodeproj
ios/*.xcworkspace
ios/build/
DerivedData/

# Backtest bar cache: raw broker output, refetchable, sometimes large
backend/.backtest-cache*.json

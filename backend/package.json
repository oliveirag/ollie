{
  "name": "ollie-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ollie orchestrator: deterministic signal generation, review snapshots, human-approved paper execution.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsx scripts/setup-test-db.ts",
    "test": "vitest run",
    "db:test:setup": "tsx scripts/setup-test-db.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "introspect:mcp": "tsx scripts/introspect-mcp.ts",
    "rh:authorize": "tsx scripts/authorize-rh.ts",
    "signal:write-test": "tsx scripts/write-test-signal.ts",
    "pipeline:once": "tsx scripts/run-pipeline-once.ts",
    "signal:decide": "tsx scripts/decide-signal.ts",
    "openapi:write": "tsx scripts/write-openapi.ts",
    "seed:track-record": "tsx scripts/seed-track-record.ts",
    "backtest": "tsx scripts/backtest.ts",
    "disclaimer:write": "tsx scripts/write-disclaimer.ts",
    "start:signal": "node dist/signal-server/index.js",
    "dev:signal": "tsx watch src/signal-server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@prisma/client": "^6.16.2",
    "croner": "^9.1.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.11.3",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pino": "^9.13.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

# Copy to .env and fill in. Never commit .env — this file documents shape only.

# --- Infrastructure ---
DATABASE_URL=postgresql://ollie:ollie@localhost:5432/ollie
PORT=3000
LOG_LEVEL=info

# --- Anthropic (thesis text only; never decides a trade) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Robinhood Agentic Trading MCP ---
RH_MCP_URL=https://agent.robinhood.com/mcp/trading
# This server speaks OAuth 2.1 + PKCE, NOT static bearer tokens (verified
# 2026-08-04 against its discovery metadata):
#   authorize  https://robinhood.com/oauth          (browser; a human must do this)
#   token      https://api.robinhood.com/oauth2/token/
#   register   https://agent.robinhood.com/oauth/trading/register  (DCR supported)
#   public client (no secret), code_challenge=S256, grant: refresh_token
# The only var the adapter reads today. It holds a short-lived OAuth *access*
# token, sent as `Bearer <token>` from McpBrokerAdapter.openConnection — that
# part of the seam was already correct. Paste one here for a manual run and it
# will work until the token expires.
RH_MCP_AUTH_TOKEN=
# NOT WIRED YET. The durable path: authorize once in a browser, keep the
# refresh token, and let the adapter mint access tokens on boot and on 401.
# Railway cannot perform the browser leg, so the refresh token is what ships.
# If refresh tokens turn out to rotate on use, these move to Postgres — an env
# var cannot store a credential that changes at runtime.
# Seed values only. Robinhood rotates refresh tokens on use, so the live
# credential lives in the `oauth_state` table: first boot copies these in if the
# table is empty, and every refresh afterwards is written back to the database.
# Editing these later has no effect unless oauth_state is cleared first.
RH_OAUTH_CLIENT_ID=
RH_OAUTH_REFRESH_TOKEN=
# Optional pin. Left blank, the account is discovered via get_accounts and must
# have agentic_allowed=true.
RH_ACCOUNT_NUMBER=

# --- Strategy ---
# Six decorrelated symbols, one per major sector: liquid, no leveraged or
# inverse products. Chosen 2026-08-20 (phase 3 plan, decision 8) because
# correlated names cross together and go flat together, fragmenting the equity
# curve — spread across sectors, entries stagger and cover each other's gaps.
# Fixed for the duration of the counted run; changing it mid-run would blend
# two strategies into one record that cannot be edited.
SYMBOL_ALLOWLIST=AAPL,MSFT,SPY,JPM,XLE,UNH
CANDLE_LOOKBACK_DAYS=180
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# --- Risk caps (enforced in the pipeline from day one) ---
ORDER_NOTIONAL_CENTS=50000
MAX_POSITION_CENTS=100000
MAX_DAILY_TRADES=3
MAX_TOTAL_EXPOSURE_CENTS=500000

# --- Execution ---
SLIPPAGE_BPS=10
SIGNAL_EXPIRY_MINUTES=15

# Trading days a lot may stay open before the time stop proposes an exit.
# Without it a sustained paper run in a trending market can end with zero closed
# trades — and therefore no win rate, no average return, and nothing worth
# publishing. Unlike the crossing rules it re-proposes every bar until decided,
# so a missed approval window is not a lost exit. Set 0 to disable it entirely
# rather than picking a number large enough to hope it never fires.
MAX_HOLDING_DAYS=30

# --- Scheduling (cron is interpreted in America/New_York) ---
PIPELINE_CRON=35 9 * * 1-5
EXPIRY_SWEEP_CRON=* * * * *
# How often to publish any approved-and-filled signal the decision route failed
# to flip (a crash between the fill and the publish). Normally finds nothing.
# Not gated on the kill switch: publication discloses a fill that already
# happened, and the feed must never be less complete than the owner's book.
PUBLISH_SWEEP_CRON=*/5 * * * *

# When the daily mark-to-market runs, ET. It appends one row per open lot so the
# equity curve knows what positions were worth on each past day — the dashboard
# computes "now" live, but history has to be written down as it happens.
#
# Gated on the kill switch like every other job. Marks are permanent, uneditable
# rows, and an incident is exactly when you least want them accruing — a gap
# reading "we were halted" is more honest than marks taken in a known-bad state.
MARK_CRON=15 16 * * 1-5

# --- Safety gates ---
# Env override. The runtime flag lives in app_settings.kill_switch so the iOS app
# can flip it later; either being on halts the pipeline.
KILL_SWITCH=false
# Second gate for live money (Phase 5). With this true AND app_settings.execution_mode
# = live (flipped from the app) AND confirm_live on the approval, an approval places
# a real order. Any one missing refuses with a 409 and the signal stays pending.
LIVE_TRADING_ENABLED=false

# --- Live orders and autonomy (Phase 5) ---
# How often open live orders are read back; a fill is recorded and published when
# the broker reports it. Observes, never acts, so the kill switch does not halt it.
ORDER_POLL_CRON=* 9-16 * * 1-5
# Deploy half of the autonomy gate; app_settings.autonomy (from the app) is the other.
# With both on, a signal is auto-approved once its veto window closes.
AUTONOMY_ENABLED=false
# Minutes the owner has to veto. 0 is fully autonomous; rehearse at 15 first.
AUTONOMY_VETO_MINUTES=5
AUTONOMY_SWEEP_CRON=* * * * *

# --- Owner API (Phase 2) ---
# Bearer credential for every /v1 route. The service refuses to start without
# one rather than serve the approval and kill-switch surface unauthenticated;
# /healthz stays public so the platform health check still works.
#
# Generate with:  openssl rand -hex 32
#
# Phase 2 has exactly one user, so this stands in for Sign in with Apple (PRD
# §5). SIWA arrives in Phase 4 with the subscriber side, where strangers make
# it earn its place. The iOS app stores this in the Keychain.
OWNER_API_TOKEN=

# --- Push (Phase 2, milestone 2.4) ---
# All four must be set or push is simply off — the notifier degrades to a
# no-op and signals still land, because push is best-effort by design and a
# partial configuration must never crash the service.
#
# Requires a paid Apple Developer Program membership: free provisioning cannot
# use APNs. Create a Key with the "Apple Push Notifications service" capability,
# then base64 the .p8 (its PEM newlines do not survive most env editors):
#
#   base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
#
APNS_KEY_P8_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.guilhermeoliveira.Ollie

# --- Signal service (Phase 4) ---
# A second deploy from this same package (`npm run start:signal`). It gets
# NONE of the variables above except LOG_LEVEL/NODE_ENV: no RH_*, no
# ANTHROPIC_*, no APNS_*, no OWNER_API_TOKEN, and not DATABASE_URL. Its only
# database access is this URL, which must connect as the `ollie_signal` role;
# the service probes on boot and refuses to start if the role can read
# oauth_state. Set the role's password per environment:
#   ALTER ROLE ollie_signal WITH PASSWORD '…';
SIGNAL_DATABASE_URL=
SIGNAL_SERVICE_PORT=3100
# Advertised to subscribers as the MCP URL base (the endpoint is <url>/mcp).
SIGNAL_PUBLIC_URL=
# Comma-separated invite codes for the soft launch. Empty = no first sign-ins.
SUBSCRIBER_INVITE_CODES=
# Sign in with Apple audience; the app's bundle id.
APPLE_APP_BUNDLE_ID=com.guilhermeoliveira.Ollie
# Accept fake identity tokens so the simulator can onboard without a paid Apple
# team. Refused in production. The iOS Debug build's "test identity" button
# sends `fake:{"sub":…}`; nothing else does.
SIWA_STUB=false

# Copy to .env and fill in. Never commit .env — this file documents shape only.

# --- Infrastructure ---
DATABASE_URL=postgresql://ollie:ollie@localhost:5432/ollie
PORT=3000
LOG_LEVEL=info

# --- Anthropic (thesis text only; never decides a trade) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Robinhood Agentic Trading MCP ---
RH_MCP_URL=https://agent.robinhood.com/mcp/trading
# UNVERIFIED as of 2026-08-04. The output shapes in test/fixtures/mcp/ were
# captured through the claude.ai connector, not a headless token, so whether
# this is a static bearer token or an OAuth token needing refresh is still
# unknown. If it turns out to need refresh, the seam for that is the
# Authorization header in McpBrokerAdapter.openConnection.
RH_MCP_AUTH_TOKEN=
# Optional pin. Left blank, the account is discovered via get_accounts and must
# have agentic_allowed=true.
RH_ACCOUNT_NUMBER=

# --- Strategy ---
SYMBOL_ALLOWLIST=AAPL,MSFT,SPY
CANDLE_LOOKBACK_DAYS=180
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# --- Risk caps (enforced in the pipeline from day one) ---
ORDER_NOTIONAL_CENTS=50000
MAX_POSITION_CENTS=100000
MAX_DAILY_TRADES=3
MAX_TOTAL_EXPOSURE_CENTS=500000

# --- Execution ---
SLIPPAGE_BPS=10
SIGNAL_EXPIRY_MINUTES=15

# --- Scheduling (cron is interpreted in America/New_York) ---
PIPELINE_CRON=35 9 * * 1-5
EXPIRY_SWEEP_CRON=* * * * *

# --- Safety gates ---
# Env override. The runtime flag lives in app_settings.kill_switch so the iOS app
# can flip it later; either being on halts the pipeline.
KILL_SWITCH=false
# Second gate for live money. Unused until Phase 5; LiveExecutor throws without it.
LIVE_TRADING_ENABLED=false
